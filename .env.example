# ReelForge configuration. Copy to .env and fill in what you need.
#
# EVERY VALUE HERE IS A PLACEHOLDER. Never commit a real key.
# .env is gitignored; .env.example is not.
#
# The defaults are chosen so ReelForge runs locally with none of this set:
# SQLite, local file storage, the mock renderer, and an in-process worker.
# No GPU, no AI credentials, no cloud account.

# ---------------------------------------------------------------------------
# Video generation provider
# ---------------------------------------------------------------------------
# mock   = the local ffmpeg renderer. No credentials, no network, no GPU.
#          Ken Burns over an uploaded still, or a typographic card. Default.
# ltx    = real AI generation through the LTX hosted API. Paid. Key below.
# kaggle = real AI generation on a free Kaggle GPU. The intended beta
#          provider. Needs REELFORGE_KAGGLE_WORKER_TOKEN below and a
#          worker session polling this API. See kaggle/README.md.
REELFORGE_VIDEO_PROVIDER=mock

# Base URL of the LTX API. The default is the official hosted service.
# Point this at your own deployment only if it speaks the same request shape.
REELFORGE_LTX_ENDPOINT=https://api.ltx.io

# Your LTX API key, from the LTX developer console. Sent as a bearer token.
# Leave blank to keep the LTX provider disabled: it reports itself
# unavailable and renders are refused up front rather than failing midway.
REELFORGE_LTX_API_KEY=

# Which model each customer-facing quality maps to. Customers pick
# "standard" or "high" and never see these names.
#   ltx-2-5-fast  up to 20s per clip
#   ltx-2-5-pro   up to 10s per clip, higher fidelity
REELFORGE_LTX_MODEL_STANDARD=ltx-2-5-fast
REELFORGE_LTX_MODEL_HIGH=ltx-2-5-pro

# Generation resolution tier: 720p, 1080p, 1440p or 4k.
# The API offers only 16:9 and 9:16; 1:1 and 4:5 are produced by generating
# portrait and cropping, so this is the tier before that crop.
REELFORGE_LTX_RESOLUTION_TIER=1080p

# Async polling. The API documents a 5 second minimum between polls.
REELFORGE_LTX_POLL_SECONDS=6
REELFORGE_LTX_MAX_POLLS=150
REELFORGE_LTX_TIMEOUT=900

# COST GUARDS. A scene longer than a model's per-clip ceiling is generated in
# chunks, so one scene can mean several billable calls. These caps stop a
# misconfiguration from fanning out.
REELFORGE_LTX_MAX_CHUNKS=6
REELFORGE_LTX_MAX_ATTEMPTS=2

# Default quality for new projects: standard or high.
REELFORGE_DEFAULT_QUALITY=standard

# ---------------------------------------------------------------------------
# Kaggle GPU beta worker
# ---------------------------------------------------------------------------
# The backend never starts a Kaggle notebook. It queues scene jobs and a
# worker running on Kaggle polls for them. See kaggle/README.md.
#
# Shared secret for the worker-only endpoints. Generate your own, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank to keep the Kaggle provider disabled and the worker API off.
# Never commit a real value. Never returned by /health.
REELFORGE_KAGGLE_WORKER_TOKEN=

# How long a scene may wait for a worker before it fails cleanly (seconds).
REELFORGE_KAGGLE_JOB_TIMEOUT=1800

# How often the provider checks its queued scene job (seconds).
REELFORGE_KAGGLE_POLL_SECONDS=3

# A claimed job whose worker went quiet for this long is requeued. Kaggle
# sessions die without warning, so this is what stops a job wedging a render.
REELFORGE_KAGGLE_CLAIM_TIMEOUT=600

# Bounded so one failing worker cannot retry a scene forever.
REELFORGE_KAGGLE_MAX_ATTEMPTS=3

# Upload ceiling for one generated scene clip, in bytes.
REELFORGE_KAGGLE_MAX_CLIP_BYTES=209715200

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# sqlite (default, local) or postgres. All SQL is dialect-neutral; postgres
# additionally needs a connection factory in app/db.py.
REELFORGE_DB_DIALECT=sqlite
# REELFORGE_DB_URL=postgresql://user:password@localhost:5432/reelforge

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# local (default) or s3. Where the database, uploads, generated scene clips
# and finished reels live.
REELFORGE_STORAGE=local
# REELFORGE_DATA_DIR=./backend/data
# REELFORGE_S3_BUCKET=
# REELFORGE_S3_ENDPOINT=
# REELFORGE_S3_PUBLIC_BASE=

# ---------------------------------------------------------------------------
# Jobs
# ---------------------------------------------------------------------------
# thread   = render in a background thread in the API process. Default.
# external = the API only enqueues; a separate worker process drains the
#            queue. Use this to verify the split before adding a broker:
#            python -c "from app import db, jobs; db.init(); jobs.drain_once()"
REELFORGE_JOB_RUNNER=thread

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Caption font. Autodetected on Windows and most Linux desktops.
# REELFORGE_FONT=C:/Windows/Fonts/segoeuib.ttf
REELFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REELFORGE_MAX_UPLOAD_BYTES=26214400

# ---------------------------------------------------------------------------
# Real LTX integration tests (billable, opt-in, never run in CI)
# ---------------------------------------------------------------------------
# Set to 1 together with a real REELFORGE_LTX_API_KEY, then run:
#   cd backend && python test_ltx_integration.py
REELFORGE_RUN_LTX_INTEGRATION=0
